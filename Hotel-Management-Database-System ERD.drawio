        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;flowchart TB\n\n%% =========================================================\n%% HOTEL\n%% =========================================================\n\nHOTEL[HOTEL]\n\nHID(&lt;u&gt;Hotel_ID&lt;/u&gt;)\nHNAME(Hotel_Name)\nHADDR(Address)\nHCITY(City)\nHCONTACT(Contact_Number)\nHSTAR(Star_Rating)\n\nHOTEL --- HID\nHOTEL --- HNAME\nHOTEL --- HADDR\nHOTEL --- HCITY\nHOTEL --- HCONTACT\nHOTEL --- HSTAR\n\n\n%% =========================================================\n%% ROOM\n%% =========================================================\n\nROOM[ROOM]\n\nRID(&lt;u&gt;Room_ID&lt;/u&gt;)\nRNUM(Room_Number)\nRTYPE(Room_Type)\nRFLOOR(Floor_Number)\nRCAP(Capacity)\nRRATE(Nightly_Rate)\nRSTATUS(Availability_Status)\n\nROOM --- RID\nROOM --- RNUM\nROOM --- RTYPE\nROOM --- RFLOOR\nROOM --- RCAP\nROOM --- RRATE\nROOM --- RSTATUS\n\n\n%% =========================================================\n%% GUEST\n%% =========================================================\n\nGUEST[GUEST]\n\nGID(&lt;u&gt;Guest_ID&lt;/u&gt;)\nGFULL(Full_Name)\nGPHONE(Phone_Number)\nGEMAIL(Email)\nGADDRESS(Address)\nGNATIONALITY(Nationality)\nGIDENT(Identification_Number)\n\nGUEST --- GID\nGUEST --- GFULL\nGUEST --- GPHONE\nGUEST --- GEMAIL\nGUEST --- GADDRESS\nGUEST --- GNATIONALITY\nGUEST --- GIDENT\n\n\n%% =========================================================\n%% EMPLOYEE\n%% =========================================================\n\nEMPLOYEE[EMPLOYEE]\n\nEID(&lt;u&gt;Employee_ID&lt;/u&gt;)\nEFULL(Full_Name)\nEDESIG(Designation)\nESALARY(Salary)\nEJOIN(Joining_Date)\nESTATUS(Employment_Status)\n\nEMPLOYEE --- EID\nEMPLOYEE --- EFULL\nEMPLOYEE --- EDESIG\nEMPLOYEE --- ESALARY\nEMPLOYEE --- EJOIN\nEMPLOYEE --- ESTATUS\n\n\n%% =========================================================\n%% RESERVATION\n%% =========================================================\n\nRESERVATION[RESERVATION]\n\nRESID(&lt;u&gt;Reservation_ID&lt;/u&gt;)\nBOOKDATE(Booking_Date)\nCHECKIN(Check_In_Date)\nCHECKOUT(Check_Out_Date)\nRESSTATUS(Reservation_Status)\nNUMGUESTS(Number_of_Guests)\n\nRESERVATION --- RESID\nRESERVATION --- BOOKDATE\nRESERVATION --- CHECKIN\nRESERVATION --- CHECKOUT\nRESERVATION --- RESSTATUS\nRESERVATION --- NUMGUESTS\n\n\n%% =========================================================\n%% SERVICE\n%% =========================================================\n\nSERVICE[SERVICE]\n\nSID(&lt;u&gt;Service_ID&lt;/u&gt;)\nSTYPE(Service_Type)\n\nSERVICE --- SID\nSERVICE --- STYPE\n\n\n%% =========================================================\n%% SERVICE RECORD\n%% =========================================================\n\nSRECORD[SERVICE_RECORD]\n\nSRID(&lt;u&gt;Service_Record_ID&lt;/u&gt;)\nSRDATE(Service_Date)\nSRQTY(Quantity)\nSRCHARGE(Charge)\n\nSRECORD --- SRID\nSRECORD --- SRDATE\nSRECORD --- SRQTY\nSRECORD --- SRCHARGE\n\n\n%% =========================================================\n%% BILL\n%% =========================================================\n\nBILL[BILL]\n\nBID(&lt;u&gt;Bill_ID&lt;/u&gt;)\nBTOTAL(Total_Amount)\nBTAX(Taxes)\nBDISCOUNT(Discounts)\nBPAYMENT(Payment_Method)\nBSTATUS(Payment_Status)\n\nBILL --- BID\nBILL --- BTOTAL\nBILL --- BTAX\nBILL --- BDISCOUNT\nBILL --- BPAYMENT\nBILL --- BSTATUS\n\n\n%% =========================================================\n%% RELATIONSHIPS\n%% =========================================================\n\nHAS_ROOM{HAS}\nEMPLOYS{EMPLOYS}\nMAKES{MAKES}\nRESERVED_FOR{RESERVED_FOR}\nHAS_SERVICE_RECORD{HAS}\nUSES{USES}\nGENERATES{GENERATES}\nINCLUDES{INCLUDES}\n\n\n%% =========================================================\n%% HOTEL - ROOM\n%% 1 : N\n%% =========================================================\n\nHOTEL --&gt;|1| HAS_ROOM\nHAS_ROOM ---|N| ROOM\n\n\n%% =========================================================\n%% HOTEL - EMPLOYEE\n%% 1 : N\n%% =========================================================\n\nHOTEL --&gt;|1| EMPLOYS\nEMPLOYS ---|N| EMPLOYEE\n\n\n%% =========================================================\n%% GUEST - RESERVATION\n%% 1 : N\n%% =========================================================\n\nGUEST --&gt;|1| MAKES\nMAKES ---|N| RESERVATION\n\n\n%% =========================================================\n%% ROOM - RESERVATION\n%% 1 : N\n%% =========================================================\n\nROOM --&gt;|1| RESERVED_FOR\nRESERVED_FOR ---|N| RESERVATION\n\n\n%% =========================================================\n%% SERVICE - SERVICE RECORD\n%% 1 : N\n%% =========================================================\n\nSERVICE --&gt;|1| HAS_SERVICE_RECORD\nHAS_SERVICE_RECORD ---|N| SRECORD\n\n\n%% =========================================================\n%% GUEST - SERVICE RECORD\n%% 1 : N\n%% =========================================================\n\nGUEST --&gt;|1| USES\nUSES ---|N| SRECORD\n\n\n%% =========================================================\n%% RESERVATION - BILL\n%% 1 : 1\n%% =========================================================\n\nRESERVATION --&gt;|1| GENERATES\nGENERATES --&gt;|1| BILL\n\n\n%% =========================================================\n%% BILL - SERVICE RECORD\n%% 1 : N\n%% =========================================================\n\nBILL --&gt;|1| INCLUDES\nINCLUDES ---|N| SRECORD\n\n\n%% =========================================================\n%% STYLING\n%% =========================================================\n\nclassDef entity fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;\nclassDef relationship fill:#ffffff,stroke:#000000,stroke-width:2px,color:#000000;\nclassDef attribute fill:#ffffff,stroke:#000000,stroke-width:1px,color:#000000;\n\nclass HOTEL,ROOM,GUEST,EMPLOYEE,RESERVATION,SERVICE,SRECORD,BILL entity;\n\nclass HAS_ROOM,EMPLOYS,MAKES,RESERVED_FOR,HAS_SERVICE_RECORD,USES,GENERATES,INCLUDES relationship;\n\nclass HID,HNAME,HADDR,HCITY,HCONTACT,HSTAR attribute;\nclass RID,RNUM,RTYPE,RFLOOR,RCAP,RRATE,RSTATUS attribute;\nclass GID,GFULL,GPHONE,GEMAIL,GADDRESS,GNATIONALITY,GIDENT attribute;\nclass EID,EFULL,EDESIG,ESALARY,EJOIN,ESTATUS attribute;\nclass RESID,BOOKDATE,CHECKIN,CHECKOUT,RESSTATUS,NUMGUESTS attribute;\nclass SID,STYPE attribute;\nclass SRID,SRDATE,SRQTY,SRCHARGE attribute;\nclass BID,BTOTAL,BTAX,BDISCOUNT,BPAYMENT,BSTATUS attribute;&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="_vh-fuaVT2H4nbtE8lZj-1">
