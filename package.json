{
  "name": "hotel-management-system-root",
  "version": "1.0.0",
  "description": "Hotel.com - Full Stack Hotel Management System",
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:server": "npm --prefix server start",
    "dev:client": "npm --prefix client run dev",
    "db:init": "npm --prefix server run db:init",
    "build": "npm --prefix client run build"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  }
}